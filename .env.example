# Copy to .env and fill in what you use. Everything is optional.
# AI tutor + news summaries (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# claude-haiku-5-5 (default, cheapest) · claude-sonnet-5-5 (~20× Haiku) · claude-opus-5-5 (~40× Haiku)
TUTOR_MODEL=claude-haiku-5-5
AI_MONTHLY_BUDGET_USD=25
TUTOR_DAILY_LIMIT=30
TUTOR_PER_MINUTE=5
# Real delayed prices (free key at https://twelvedata.com)
TWELVEDATA_API_KEY=
# Simulated CETES rate, % a year, from Banxico's latest auction
CETES_RATE=
CETES_RATE_DATE=
# Private beta: require this code to sign up
SIGNUP_CODE=
# Admin page (/admin): 20+ random characters
ADMIN_TOKEN=
# Alerts to Discord/Slack (optional)
ALERT_WEBHOOK_URL=
# Password reset email from a dedicated Gmail (docs/SETUP-KEYS.md §4)
SMTP_USER=
SMTP_PASS=
PUBLIC_URL=
CONTACT_EMAIL=
# Mailing address in the weekly recap's footer (a P.O. box or virtual mailbox) — before the public launch
MAIL_POSTAL_ADDRESS=
# Hosting
PORT=8950
HOST=127.0.0.1
ALLOWED_HOSTS=
TRUST_PROXY=
# Vercel + Supabase (docs/VERCEL-SUPABASE.md). With DATABASE_URL set, the data
# lives in Supabase's Postgres instead of a file. Use the connection pooler's
# "Transaction" address (port 6543) from Supabase → Connect.
DATABASE_URL=
# 20+ random characters: lets Supabase and Vercel Cron start the scheduled work
CRON_SECRET=
